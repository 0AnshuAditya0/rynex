# ============================================================
# RYNEX — root .gitignore (covers frontend/ and backend/)
# ============================================================

# ---------- Frontend (Next.js / Node) ----------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo
frontend/.vercel
frontend/*.tsbuildinfo

# ---------- Backend (Python / FastAPI) ----------
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.venv/
backend/venv/
backend/env/
backend/.env
backend/.env.local
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/instance/
backend/.Python

# ---------- Shared / OS / Editor ----------
.DS_Store
Thumbs.db
*.log
*.tmp
.idea/
.vscode/
*.swp

# ---------- Secrets — never commit ----------
*.pem
*.key
**/secrets.json
**/credentials.json

# ---------- Local test/debug artifacts from this project ----------
*.png
!frontend/public/**/*.png
test.zip
actor1.png
actor3.png
actor_zero.png
shot_*.png